# Copy this file to .env and paste your own free Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your-key-here

# Optional: LangSmith monitoring (https://smith.langchain.com -> Settings -> API Keys).
# With these set, every V1-V4 question is traced: retriever, reranker, prompt, LLM, tokens, latency.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=health-faq-rag
